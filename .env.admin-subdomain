# 独立子域名部署：https://admin.entroaxiom.com/
#
# 用法：pnpm build:admin:subdomain（等价于 vite build --mode admin-subdomain）
#
# 与 .env.admin（挂在 https://entroaxiom.com/admin/ 子路径）互斥：
#   - 子路径模式：VITE_PUBLIC_PATH=/admin/、VITE_ROUTER_HISTORY="hash,/admin/"
#   - 子域名模式：VITE_PUBLIC_PATH=/、VITE_ROUTER_HISTORY="hash"
# 这里必须写 VITE_PUBLIC_PATH=/ —— 否则产物会去 /admin/static/ 找资源，子域名下必然白屏。
#
# Nginx 上把本文件对应的 dist/ 直接作为 https://admin.entroaxiom.com/ 的 root，
# /api/ 反代到同一个 127.0.0.1:8000（与前台域名共用后端）。
VITE_PUBLIC_PATH = /

VITE_ROUTER_HISTORY = "hash"

# 生产环境不要开开发替身（没有真后端时页面会一片空白，这是有意的）
VITE_MOCK = false

# 管理接口前缀：浏览器 → 同源 /api/admin → Nginx → 后端
VITE_API_BASE = /api/admin

# 前台站点基址（必须与后端 PUBLIC_ORIGIN 一致）。
# 仅用于文章页「在站点中查看」的绝对链接；留空则隐藏该入口。
VITE_SITE_URL = https://entroaxiom.com

# 独立域名下同样走本地资源，不引外部 CDN
VITE_CDN = false

VITE_COMPRESSION = "none"
