# 部署路径：挂在 https://entroaxiom.com/admin/ 下
#
# 用法：pnpm build:admin（等价于 vite build --mode admin）
# 两个值必须同时改，只改一个的结果是白屏或路由 404：
#   VITE_PUBLIC_PATH      → 静态资源（JS/CSS/字体）的前缀
#   VITE_ROUTER_HISTORY   → 路由的 base；hash 模式下写 "hash,/admin/"
#
# 若最终是挂在域名根路径，不要用这个文件，直接用默认的 .env.production。
VITE_PUBLIC_PATH = /admin/

VITE_ROUTER_HISTORY = "hash,/admin/"

# 前台站点基址（必须与后端 PUBLIC_ORIGIN 一致）。
# 仅用于文章页「在站点中查看」的绝对链接；留空则隐藏该入口。
VITE_SITE_URL = https://entroaxiom.com

# 生产环境不要开开发替身（没有真后端时页面会一片空白，这是有意的）
VITE_MOCK = false

# 子路径下不建议用 CDN 替换本地库，省得再配一套跨域
VITE_CDN = false

VITE_COMPRESSION = "none"
