# 平台本地运行端口号
VITE_PORT = 8848

# 开发时 /api 转发到的后端地址（默认 http://127.0.0.1:8000，需要改端口时取消注释）
# VITE_DEV_BACKEND = http://127.0.0.1:8000

# 是否装入开发替身（src/mock）：没有后端时也能把每个页面点开看看。
# 改成 false 就直连真后端；替身数据只在内存里，刷新即重置。
VITE_MOCK = true

# 开发环境读取配置文件路径
VITE_PUBLIC_PATH = /

# 开发环境路由历史模式（Hash模式传"hash"、HTML5模式传"h5"、Hash模式带base参数传"hash,base参数"、HTML5模式带base参数传"h5,base参数"）
VITE_ROUTER_HISTORY = "hash"
